{% if lineage|length > 1 or correction %}<section class="panel folio revisions"><h2>修订沿革</h2><div class="scroll"><table><thead><tr><th>修订</th><th>留档号</th><th>签发时间 UTC</th><th>由哪版更正</th><th>皮重更正</th><th>原件</th></tr></thead><tbody>{% for m in lineage %}<tr{% if m.key==key %} class="current"{% endif %}><th scope="row">{{ m.revision }}{% if m.key==key %} · 当前{% endif %}</th><td><a href="{{ url_for('studio.desk',screen='receipt',key=m.key) }}">{{ m.key[:18] }}</a></td><td>{{ m.issued_at }}</td><td>{{ (m.correction.parent[:18] + '…') if m.correction else '—' }}</td><td>{% if m.correction %}{% for c in m.correction.changes %}{{ correction_actions.get(c.action,c.action) }} {{ c.container }}/{{ c.version }}{% if not loop.last %}；{% endif %}{% endfor %}{% else %}原件签发{% endif %}</td><td><a href="{{ url_for('palette.export',key=m.key) }}">下载</a></td></tr>{% endfor %}</tbody></table></div></section>
{% if correction %}<section class="panel folio correction-note"><h2>本版皮重更正</h2><p>由 <a href="{{ url_for('studio.desk',screen='receipt',key=correction.parent) }}">第 {{ meta.revision-1 }} 版（{{ correction.parent[:18] }}…）</a> 更正而来，原因：{{ correction.reason or '未注明' }}。</p><div class="scroll"><table><thead><tr><th>动作</th><th>容器 / 版本</th><th>原件行</th><th>原行</th><th>更正后</th></tr></thead><tbody>{% for c in correction.changes %}<tr><th scope="row">{{ correction_actions.get(c.action,c.action) }}</th><td>{{ c.container }} / {{ c.version }}</td><td>{{ c.line if c.line else '补报' }}</td><td class="clip" title="{{ (c.before or [])|join(' / ') }}">{{ (c.before or ['—'])|join(' / ') }}</td><td class="clip" title="{{ c.after|join(' / ') }}">{{ c.after|join(' / ') }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="panel folio"><h2>同罐后续重算</h2><p>受影响混料罐：{% for pot in correction.affected.pots %}<code>{{ pot }}</code>{% if not loop.last %} · {% endif %}{% else %}无{% endfor %}。以下逐票列出净重与成分分摊的前后值。</p><div class="scroll"><table><thead><tr><th>罐 / 票号</th><th>动作</th><th>净重 前 → 后 g</th><th>成分分摊 前 → 后 g</th><th>期末存量 前 → 后 g</th></tr></thead><tbody>{% for section in correction.affected.recalc %}{% for r in section.tickets %}<tr><th scope="row">{{ section.pot }} / {{ r.ticket }}</th><td>{{ actions.get(r.action,r.action) }}</td><td>{{ grams(r.net_before_mg) }} → {{ grams(r.net_after_mg) }}</td><td>{% for lot,qty in (r.parts_before_mg or {}).items() %}<span class="allocation">{{ lot }} <b>{{ grams(qty) }}</b></span>{% endfor %} → {% for lot,qty in (r.parts_after_mg or {}).items() %}<span class="allocation">{{ lot }} <b>{{ grams(qty) }}</b></span>{% endfor %}</td><td>{% for lot,qty in (r.stock_before_mg or {}).items() %}<span class="allocation">{{ lot }} {{ grams(qty) }}</span>{% endfor %} → {% for lot,qty in (r.stock_after_mg or {}).items() %}<span class="allocation">{{ lot }} {{ grams(qty) }}</span>{% endfor %}</td></tr>{% endfor %}{% else %}<tr><td colspan="5">没有同罐后续用料或回桶成分变化。</td></tr>{% endfor %}</tbody></table></div></section>
{% endif %}{% endif %}