{% if key and screen=='tares' and can_correct %}<section class="panel folio correction-entry"><h2>皮重更正</h2><p class="quiet">在本版（第 {{ meta.revision|default(1) }} 版）基础上签发下一版更正收据。旧收据与展陈方手里的原件都不改动；重算失败时旧版继续可用，重试同一更正不会重复签发。</p><form id="correction-form" data-key="{{ key }}"><label>容器 <select name="container" id="correction-container" required>{% for container in tare_choices %}<option value="{{ container }}">{{ container }}</option>{% endfor %}</select></label><label>版本 <select name="version" id="correction-version"></select></label><label>皮重 <input name="mass" id="correction-mass" inputmode="decimal" placeholder="如 22 或 0.022" required></label><label>单位 <select name="unit" id="correction-unit"><option value="g">g</option><option value="kg">kg</option><option value="mg">mg</option></select></label><label>原因 <input name="reason" id="correction-reason" maxlength="500" placeholder="补测、换罐等"></label><button type="submit">签发改正收据</button></form><p id="correction-feedback" role="status" hidden></p><script type="application/json" id="correction-choices">{{ tare_choices|tojson }}</script></section>{% endif %}